 /** Published input price, USD per million input tokens. Output is not billed. */
 export const USD_PER_MTOK = 0.042;
+/**
+ * Respan models on OpenRouter take the state as text and only noul questions
+ * whose instructions and criteria are plain strings.
+ */
+function isRespan(model) {
+    return String(model).startsWith("respan/");
+}
+const asText = (value) => (typeof value === "string" ? value : JSON.stringify(value));
+export function wireState(model, state) {
+    if (!isRespan(model) || !state || typeof state !== "object")
+        return state;
+    return Object.entries(state)
+        .map(([key, value]) => `## ${key}\n${asText(value)}`)
+        .join("\n\n");
+}
+export function wireQuestions(model, questions) {
+    if (!isRespan(model))
+        return questions;
+    return Object.fromEntries(Object.entries(questions).map(([id, q]) => {
+        if (q.type !== "noul") {
+            throw new JevError(`${model} answers only noul questions, and ${id} is ${q.type}: judge this rule with another model`, { kind: "auth" });
+        }
+        return [id, {
+                ...q,
+                instructions: typeof q.instructions === "string"
+                    ? q.instructions
+                    : Object.entries(q.instructions).map(([key, value]) => `${key}: ${asText(value)}`).join("\n"),
+                ...(q.criteria ? { criteria: Object.fromEntries(Object.entries(q.criteria).map(([key, value]) => [key, asText(value)])) } : {}),
+            }];
+    }));
+}
+/**
+ * What OpenRouter records on each generation to tell the sender apart: the
+ * app (referer and title), `user` as `<place>:<project>:jev-lint <command>`
+ * and the Claude Code session or the Actions run as `session_id`.
+ */
+export function attribution(baseUrl, env = process.env) {
+    if (!String(baseUrl).includes("openrouter.ai"))
+        return { headers: {}, body: {} };
+    const place = env.GITHUB_ACTIONS === "true" ? "ci" : env.CLAUDE_CODE_REMOTE === "true" ? "cloud" : "local";
+    const project = process.cwd().split(/[\\/]/).filter(Boolean).at(-1) ?? "";
+    const session = env.CLAUDE_CODE_SESSION_ID || env.GITHUB_RUN_ID || "";
+    return {
+        headers: { "HTTP-Referer": "https://github.com/mizchi/jev-lint", "X-OpenRouter-Title": "jev-lint" },
+        body: { user: `${place}:${project}:jev-lint ${process.argv[2] ?? ""}`.trim(), ...(session ? { session_id: session } : {}) },
+    };
+}
 export class JevError extends Error {
